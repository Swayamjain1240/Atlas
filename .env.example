# ── Atlas Environment Variables ──────────────────────────────────────────
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# Atlas API secret key (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
ATLAS_API_KEY=

# Ollama (local LLM)
OLLAMA_URL=http://localhost:11434
ATLAS_LLM_MODEL=llama3.2:3b
ATLAS_LLM_TEMP=0.1
ATLAS_LLM_MAX_TOKENS=4096

# Atlas Server
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8741
ATLAS_DEBUG=false

# Embedding Model (local, no API)
ATLAS_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Privacy mode: "local" (default) or "hybrid"
ATLAS_PRIVACY=local

# Data Directories (defaults to ~/.atlas)
ATLAS_DATA_DIR=
ATLAS_DB_DIR=
