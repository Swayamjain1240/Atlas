# Atlas backend local environment
# Copy this file to backend/.env. Never commit backend/.env.

# Public gateway / preserved legacy compatibility service
NODE_ENV=development
ATLAS_API_KEY=
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8741
ATLAS_DEBUG=false
ATLAS_PRIVACY=local
ATLAS_CORS_ORIGINS=http://localhost:5173,http://localhost:8741
ATLAS_RATE_LIMIT=100

# Local data paths; blank values use the service defaults.
ATLAS_DATA_DIR=
ATLAS_DB_DIR=
ATLAS_DB_FILE=
ATLAS_LOG_DIR=
ATLAS_CACHE_DIR=

# Private worker bridge reserved for B.1/B.2.
AI_SERVICE_URL=http://127.0.0.1:8750
AI_SERVICE_INTERNAL_TOKEN=

# Legacy compatibility-only AI settings. These move to aiServices/.env when
# the private worker replaces the preserved FastAPI service.
OLLAMA_URL=http://127.0.0.1:11434
ATLAS_LLM_MODEL=llama3.2:3b
ATLAS_LLM_TEMP=0.1
ATLAS_LLM_MAX_TOKENS=4096
ATLAS_EMBEDDING_MODEL=all-MiniLM-L6-v2
