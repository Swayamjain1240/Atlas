# Atlas frontend local environment
# Copy this file to frontend/.env. Vite exposes VITE_* values to the browser;
# never put API keys, internal tokens or other secrets here.

VITE_API_BASE_URL=/api/v1
VITE_API_ORIGIN=http://127.0.0.1:8741
VITE_APP_ENV=development
VITE_ENABLE_GRAPH=true
VITE_REDUCED_MOTION=false
