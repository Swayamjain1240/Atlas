# Atlas private AI service environment
# Copy this file to aiServices/.env. Never commit aiServices/.env.

# Private loopback worker; public exposure is not allowed.
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8750
AI_SERVICE_INTERNAL_TOKEN=
AI_SERVICE_REQUEST_TIMEOUT=10
AI_SERVICE_EMBED_TIMEOUT=60
AI_SERVICE_OLLAMA_TIMEOUT=30
AI_SERVICE_MAX_BATCH=128
AI_SERVICE_MAX_TEXT_LENGTH=12000
AI_SERVICE_EMBEDDING_DIMENSIONS=384
AI_SERVICE_DOCS=false

# Local Ollama and embedding models.
OLLAMA_URL=http://127.0.0.1:11434
ATLAS_LLM_MODEL=llama3.2:3b
ATLAS_LLM_TEMP=0.1
ATLAS_LLM_MAX_TOKENS=4096
ATLAS_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Local worker data and logging.
ATLAS_DATA_DIR=
ATLAS_VECTOR_DB_DIR=
ATLAS_LOG_LEVEL=INFO
